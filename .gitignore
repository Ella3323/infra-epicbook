# --- Terraform working files ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
tfplan
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Variable / backend files ---
# Ignore all tfvars EXCEPT terraform.tfvars, which holds only non-sensitive values
# (region, CIDRs, admin IP). Secrets come from TF_VAR_ env vars / pipeline secrets.
*.tfvars
*.tfvars.json
!terraform.tfvars
backend.hcl

# --- Keys and credentials (public .pub keys are allowed) ---
*.pem
*.key
epicbook-aws-key
.env
.aws/
